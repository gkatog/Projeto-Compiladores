digraph G { graph [rankdir=LR, fontname="DejaVu Sans", fontsize=16, labelloc=t, pad=0.3, nodesep=0.5, ranksep=0.7];
node [fontname="DejaVu Sans", fontsize=12, shape=circle, style=filled, fillcolor="#FFFFFF", width=1.1, fixedsize=true];
edge [fontname="DejaVu Sans", fontsize=11];
start [shape=point, width=0.15, fixedsize=true];
label="AFD — Espaços em Branco e Comentários (não geram token)\n(Scanner.java: skipWhitespaceAndComments, enum SkipState)";
node [width=1.3, fontsize=11];
C0 [label="C0_INICIO"];
C1 [label="C1_BARRA"];
C2 [label="C2_COMENT\n_LINHA"];
C3 [label="C3_COMENT\n_BLOCO"];
C4 [label="C4_COMENT\n_BLOCO\n_ESTRELA"];
S  [label="início de token\n→ scanToken()", shape=box, style="rounded,filled", fillcolor="#E3F2E1", color="#2E7D32", fixedsize=false, width=0];
E  [label="ERRO: comentário de bloco\nnão fechado até o fim do arquivo", shape=box, style="rounded,filled", fillcolor="#FDE2E2", color="#C0392B", fontcolor="#C0392B", fixedsize=false, width=0];
start -> C0;
C0 -> C0 [label="' ' | \\t | \\r | \\n"];
C0 -> C1 [label="'/' seguido de '/' ou '*'\n(lookahead)"];
C1 -> C2 [label="'/'"];
C1 -> C3 [label="'*'"];
C2 -> C2 [label="≠ \\n"];
C2 -> C0 [label="\\n | EOF"];
C3 -> C3 [label="≠ '*'"];
C3 -> C4 [label="'*'"];
C4 -> C4 [label="'*'"];
C4 -> C3 [label="outro"];
C4 -> C0 [label="'/'"];
C0 -> S [label="outro", style=dashed];
C3 -> E [label="EOF", color="#C0392B", fontcolor="#C0392B"];
C4 -> E [label="EOF", color="#C0392B", fontcolor="#C0392B"];
}
