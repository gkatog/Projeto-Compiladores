digraph G { graph [rankdir=LR, fontname="DejaVu Sans", fontsize=16, labelloc=t, pad=0.3, nodesep=0.5, ranksep=0.7];
node [fontname="DejaVu Sans", fontsize=12, shape=circle, style=filled, fillcolor="#FFFFFF", width=1.1, fixedsize=true];
edge [fontname="DejaVu Sans", fontsize=11];
start [shape=point, width=0.15, fixedsize=true];
label="AFD — Strings\n(Scanner.java: case Q0_INICIO, case Q4_STR, case Q5_STR_FIM)\nd = aspa que abriu a string (\" ou ')";
Q0 [label="Q0_INICIO"];
Q4 [label="Q4_STR"];
Q5 [label="Q5_STR_FIM", shape=doublecircle];
T  [label="LIT_STRING", shape=box, style="rounded,filled", fillcolor="#E3F2E1", color="#2E7D32", fixedsize=false, width=0];
E1 [label="ERRO: string não fechada\naté o fim da linha\n(\\n não é consumido)", shape=box, style="rounded,filled", fillcolor="#FDE2E2", color="#C0392B", fontcolor="#C0392B", fixedsize=false, width=0];
E2 [label="ERRO: string não fechada\naté o fim do arquivo", shape=box, style="rounded,filled", fillcolor="#FDE2E2", color="#C0392B", fontcolor="#C0392B", fixedsize=false, width=0];
start -> Q0;
Q0 -> Q4 [label="aspa \" ou ' (guarda d)"];
Q4 -> Q4 [label="qualquer caractere\n≠ d, ≠ \\n, ≠ \\r"];
Q4 -> Q5 [label="d"];
Q4 -> E1 [label="\\n | \\r", color="#C0392B", fontcolor="#C0392B"];
Q4 -> E2 [label="EOF", color="#C0392B", fontcolor="#C0392B"];
Q5 -> T [style=dashed];
}
