digraph G { graph [rankdir=LR, fontname="DejaVu Sans", fontsize=16, labelloc=t, pad=0.3, nodesep=0.5, ranksep=0.7];
node [fontname="DejaVu Sans", fontsize=12, shape=circle, style=filled, fillcolor="#FFFFFF", width=1.1, fixedsize=true];
edge [fontname="DejaVu Sans", fontsize=11];
start [shape=point, width=0.15, fixedsize=true];
label="AFD — Literais Lógicos e Operadores Lógicos: .T. .F. .AND. .OR. .NOT.\n(Scanner.java: case Q6_PONTO, case Q7_PONTO_PALAVRA, case Q8_PONTO_FIM)";
Q0 [label="Q0_INICIO"];
Q6 [label="Q6_PONTO"];
Q7 [label="Q7_PONTO\n_PALAVRA", fontsize=11];
Q8 [label="Q8_PONTO\n_FIM", shape=doublecircle, fontsize=11];
T  [label="palavra na tabela DOT_WORDS:\nT, F → LOGICAL\nAND → AND, OR → OR, NOT → NOT", shape=box, style="rounded,filled", fillcolor="#E3F2E1", color="#2E7D32", fixedsize=false, width=0];
E1 [label="ERRO: '.' isolado", shape=box, style="rounded,filled", fillcolor="#FDE2E2", color="#C0392B", fontcolor="#C0392B", fixedsize=false, width=0];
E2 [label="ERRO: sem ponto final\n(retrocede para depois do '.')", shape=box, style="rounded,filled", fillcolor="#FDE2E2", color="#C0392B", fontcolor="#C0392B", fixedsize=false, width=0];
E3 [label="ERRO: palavra desconhecida\n(ex.: .XOR.)", shape=box, style="rounded,filled", fillcolor="#FDE2E2", color="#C0392B", fontcolor="#C0392B", fixedsize=false, width=0];
start -> Q0;
Q0 -> Q6 [label="'.'"];
Q6 -> Q7 [label="letra"];
Q7 -> Q7 [label="letra"];
Q7 -> Q8 [label="'.'"];
Q8 -> T  [label="palavra válida", style=dashed];
Q6 -> E1 [label="outro", color="#C0392B", fontcolor="#C0392B"];
Q7 -> E2 [label="outro", color="#C0392B", fontcolor="#C0392B"];
Q8 -> E3 [label="palavra inválida", color="#C0392B", fontcolor="#C0392B"];
}
