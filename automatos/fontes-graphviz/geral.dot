digraph G { graph [rankdir=LR, fontname="DejaVu Sans", fontsize=16, labelloc=t, pad=0.3, nodesep=0.5, ranksep=0.7];
node [fontname="DejaVu Sans", fontsize=12, shape=circle, style=filled, fillcolor="#FFFFFF", width=1.1, fixedsize=true];
edge [fontname="DejaVu Sans", fontsize=11];
start [shape=point, width=0.15, fixedsize=true];
label="AFD Geral do Scanner (visão resumida)\nCada estado corresponde a um 'case' do enum State em Scanner.java";
node [width=1.25, fontsize=11];
Q0 [label="Q0_INICIO"];
Q1 [label="Q1_ID", shape=doublecircle];
Q2 [label="Q2_INT", shape=doublecircle];
Q3 [label="Q3_DEC", shape=doublecircle];
Q4 [label="Q4_STR"];
Q5 [label="Q5_STR_FIM", shape=doublecircle];
Q6 [label="Q6_PONTO"];
Q7 [label="Q7_PONTO\n_PALAVRA"];
Q8 [label="Q8_PONTO\n_FIM", shape=doublecircle];
Q9 [label="Q9_OP\n_SIMPLES", shape=doublecircle];
OPS [label="Q10 ... Q18\n(operadores compostos,\nver AFD de operadores)", shape=box, style="rounded,filled", fillcolor="#FFFFFF", fixedsize=false, width=0];
E [label="ERRO: caractere fora\ndo alfabeto (consome 1)", shape=box, style="rounded,filled", fillcolor="#FDE2E2", color="#C0392B", fontcolor="#C0392B", fixedsize=false, width=0];
start -> Q0;
Q0 -> Q1 [label="letra | '_'"];
Q1 -> Q1 [label="letra | dígito | '_'"];
Q0 -> Q2 [label="dígito"];
Q2 -> Q2 [label="dígito"];
Q2 -> Q3 [label="'.' + dígito"];
Q3 -> Q3 [label="dígito"];
Q0 -> Q4 [label="aspa \" ou ' (guarda d)"];
Q4 -> Q4 [label="≠ d, ≠ \\n"];
Q4 -> Q5 [label="d"];
Q0 -> Q6 [label="'.'"];
Q6 -> Q7 [label="letra"];
Q7 -> Q7 [label="letra"];
Q7 -> Q8 [label="'.'"];
Q0 -> Q9 [label="+ - * / ( ) , ;"];
Q0 -> OPS [label="= : < >"];
Q0 -> E [label="outro", color="#C0392B", fontcolor="#C0392B"];
}
