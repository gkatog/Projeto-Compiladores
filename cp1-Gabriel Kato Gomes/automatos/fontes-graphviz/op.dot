digraph G { graph [rankdir=LR, fontname="DejaVu Sans", fontsize=16, labelloc=t, pad=0.3, nodesep=0.5, ranksep=0.7];
node [fontname="DejaVu Sans", fontsize=12, shape=circle, style=filled, fillcolor="#FFFFFF", width=1.1, fixedsize=true];
edge [fontname="DejaVu Sans", fontsize=11];
start [shape=point, width=0.15, fixedsize=true];
label="AFD — Operadores e Delimitadores (maximal munch)\n(Scanner.java: case Q9_OP_SIMPLES ... case Q18_MAIOR_IGUAL)\n\nTokens de aceitação:\nQ10 → EQ (=)     Q11 → EQ (==)     Q13 → ASSIGN (:=)\nQ14 → LT (<)     Q15 → LE (<=)     Q16 → NEQ (<>)\nQ17 → GT (>)     Q18 → GE (>=)\nEm Q10, Q14 e Q17, qualquer outro caractere aceita o token curto (não consome).";
node [width=1.25, fontsize=11];
Q0  [label="Q0_INICIO"];
Q9  [label="Q9_OP\n_SIMPLES", shape=doublecircle];
Q10 [label="Q10_IGUAL", shape=doublecircle];
Q11 [label="Q11_IGUAL\n_IGUAL", shape=doublecircle];
Q12 [label="Q12_DOIS\n_PONTOS"];
Q13 [label="Q13_ATRIB", shape=doublecircle];
Q14 [label="Q14_MENOR", shape=doublecircle];
Q15 [label="Q15_MENOR\n_IGUAL", shape=doublecircle];
Q16 [label="Q16\n_DIFERENTE", shape=doublecircle];
Q17 [label="Q17_MAIOR", shape=doublecircle];
Q18 [label="Q18_MAIOR\n_IGUAL", shape=doublecircle];
T9  [label="+ - * / ( ) , ;\nPLUS MINUS MULT DIV\nLPAREN RPAREN COMMA SEMI", shape=box, style="rounded,filled", fillcolor="#E3F2E1", color="#2E7D32", fixedsize=false, width=0];
E   [label="ERRO: ':' sozinho", shape=box, style="rounded,filled", fillcolor="#FDE2E2", color="#C0392B", fontcolor="#C0392B", fixedsize=false, width=0];
start -> Q0;
Q0 -> Q9  [label="+ - * / ( ) , ;"];
Q9 -> T9  [style=dashed];
Q0 -> Q10 [label="'='"];
Q10 -> Q11 [label="'='"];
Q0 -> Q12 [label="':'"];
Q12 -> Q13 [label="'='"];
Q12 -> E [label="outro", color="#C0392B", fontcolor="#C0392B"];
Q0 -> Q14 [label="'<'"];
Q14 -> Q15 [label="'='"];
Q14 -> Q16 [label="'>'"];
Q0 -> Q17 [label="'>'"];
Q17 -> Q18 [label="'='"];
}
